# Copie para .env.local e preencha. Sem estas variáveis o app roda em
# MODO DEMONSTRAÇÃO, com dados de reserva identificados na interface.

# --- Supabase (Settings > API) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Usada pelo seed e por rotinas administrativas.
SUPABASE_SECRET_KEY=

# --- Copernicus Data Space Ecosystem (NDVI via Sentinel-2) ---------------
# dataspace.copernicus.eu > User settings > OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Claude API (diagnóstico com IA) -------------------------------------
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
ANTHROPIC_MODEL=

# NASA POWER (clima) não precisa de chave.
